# Generated by running the tests: keep the tree clean, this kept coming back.
__pycache__/
*.pyc

# Local state, never committed: the configuration, the keys, the logs, the run files, this host's variables.
config/eden.json
secrets/
data/
run/
logs/
vars.env
env/
*.bak*

# Web UI: dependencies and build output (CI builds it, it is never committed).
webui/node_modules/
webui/dist/
webui/dist*/
