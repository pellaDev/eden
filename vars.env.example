# Optional settings for start.sh. Copy this file to vars.env (next to start.sh) and uncomment what you want to change.
# Anything left unset defaults to a place inside the Eden folder. Values here are plain shell assignments.

# --- where Eden keeps things (defaults shown)
#EDEN_CONFIG=$HERE/config/eden.json
#EDEN_AVATARS=$HERE/data/avatars.json
#EDEN_RUN=$HERE/data/run
#EDEN_LOGS=$HERE/data/logs
# The folder of the password hash and the TOTP secret. It may be a symlink onto an encrypted volume: start.sh refuses
# to start if the link is broken.
#EDEN_SECRETS=$HERE/secrets
#EDEN_VENV=$HERE/.venv

# --- ports and network
#EDEN_LOCAL_PORT=8780          # the admin UI, always on 127.0.0.1 only
#MESH_IFACE=nordlynx           # the Meshnet interface
# A web service on 127.0.0.1 that a logged-in remote user is forwarded to (the port only). Empty = none: the user is
# sent to Eden's own dashboard.
#EDEN_UPSTREAM_PORT=

# --- the root helper (installed by install.sh)
#EDEN_HELPER=/usr/local/libexec/eden/eden_helper.py

# --- "Open file" in the Services page: how the allowed-ports file is opened with sudoedit
#EDEN_TERMINAL=
#EDEN_PORTS_EDITOR=

# --- Nord
# Set to 1 when the nordvpn command needs the "nordvpn" group of the current session (sg).
#NORD_USE_SG=0
